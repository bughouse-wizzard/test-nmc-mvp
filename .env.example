# Application Settings
DEBUG=true
APP_NAME=nmck-calculator
APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nmck_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nmck_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=NMCK Calculation System
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# DeepSeek AI API Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Parsing Settings
ZAKUPKI_BASE_URL=https://zakupki.gov.ru
REQUEST_TIMEOUT=30
MAX_RETRIES=3
CRAWL_DELAY=60  # seconds between requests

# Worker Settings
WORKER_CONCURRENCY=2
TASK_TIME_LIMIT=300  # 5 minutes per task

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Email Settings (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@nmck-calculator.local