# НМЦК Расчет система - Environment Variables
# Copy this file to .env and fill in the values

# ========== API Keys ==========
# DeepSeek API Key for AI processing
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ========== Database Configuration ==========
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nmck_db

# PostgreSQL connection details (alternative to DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nmck_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ========== Redis Configuration ==========
# Redis connection string for Celery and caching
REDIS_URL=redis://localhost:6379/0

# Redis connection details (alternative to REDIS_URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== Celery Configuration ==========
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========== Application Settings ==========
# Application environment
ENVIRONMENT=development  # development, staging, production

# Log level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true  # Set to false in production

# CORS settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:80", "http://localhost"]

# ========== File Storage ==========
# Upload directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes

# ========== External Services ==========
# Zakupki.gov.ru settings
ZAKUPKI_BASE_URL=https://zakupki.gov.ru
ZAKUPKI_REQUEST_DELAY=60  # Delay between requests in seconds (respect robots.txt)
ZAKUPKI_MAX_RETRIES=3
ZAKUPKI_TIMEOUT=30

# ========== AI/ML Settings ==========
# DeepSeek configuration
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TEMPERATURE=0.1

# Matching engine settings
MATCH_SCORE_THRESHOLD=70  # Minimum AI score to consider contract
IDENTICAL_MATCH_THRESHOLD=90  # Score threshold for identical match
HOMOGENEOUS_MATCH_THRESHOLD=60  # Score threshold for homogeneous match

# ========== Security ==========
# Secret key for JWT tokens (for future authentication)
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========== Monitoring ==========
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ========== Email Configuration (for future notifications) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@nmck-calc.ru

# ========== Rate Limiting ==========
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds